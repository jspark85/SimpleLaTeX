<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<style>
  body { font-family: 'Segoe UI', sans-serif; padding: 10px; color: #333; }
  h3 { margin-top: 0; color: #2c3e50; border-bottom: 2px solid #3498db; padding-bottom: 10px; }
  .container { display: flex; flex-direction: column; gap: 15px; }
  textarea {
    width: 100%; height: 120px; padding: 12px; border: 1px solid #ccc;
    border-radius: 4px; font-family: monospace; font-size: 14px;
    resize: vertical; box-sizing: border-box;
  }
  button {
    background-color: #3498db; color: white; border: none; padding: 12px 20px;
    border-radius: 4px; font-size: 15px; font-weight: bold; cursor: pointer;
  }
  button:hover { background-color: #2980b9; }
  .output-wrapper { position: relative; margin-top: 10px; }
  .copy-btn {
    position: absolute; top: 5px; right: 5px; background-color: #eee;
    padding: 5px 10px; font-size: 12px; border: 1px solid #ccc; cursor: pointer;
  }
  .desc { font-size: 13px; color: #666; line-height: 1.6; background: #f9f9f9; padding: 10px; border-radius: 4px; }
  code { color: #e74c3c; font-weight: bold; }
</style>
</head>
<body>

  <h3>LaTeX 화학식 변환기 (연속 숫자 처리)</h3>
  
  <div class="container">
    <textarea id="inputText" placeholder="예: SO42-, Fe(CN)63-, H2O, Mg2+"></textarea>

    <button onclick="convert()">LaTeX 변환하기 ▼</button>

    <div class="output-wrapper">
      <textarea id="outputText" readonly></textarea>
      <button class="copy-btn" onclick="copyResult()">복사</button>
    </div>
    
    <div class="desc">
      <strong>✨ 작동 원리:</strong><br>
      1. <code>SO42-</code> 처럼 숫자가 연달아 오면: 앞 숫자(4)는 <b>아래첨자</b>, 뒤 숫자와 기호(2-)는 <b>윗첨자</b>로 바뀝니다.<br>
      2. <code>Na+</code> 처럼 기호만 있으면 <b>윗첨자</b>로 바뀝니다.<br>
      3. <code>H2O</code> 처럼 숫자만 있으면 <b>아래첨자</b>로 바뀝니다.
    </div>
  </div>

  <script>
    function convert() {
      let text = document.getElementById('inputText').value;

      // 1. [숫자] + [숫자][+/-] 패턴 처리 (예: 42- -> $_{4}$^{2-}$)
      // ([a-zA-Z\)]) : 앞의 문자나 닫는괄호
      // (\d)          : 첫 번째 숫자 (아래첨자용)
      // (\d*[+-])     : 두 번째 숫자(옵션)와 기호 (윗첨자용)
      text = text.replace(/([a-zA-Z\)])(\d)(\d*[+-])/g, '$1$_{$2}$^{$3}$');

      // 2. 남은 이온 전하 처리 (예: Na+, Ca2+)
      // 숫자가 하나만 있고 기호와 붙어있는 경우를 윗첨자로
      text = text.replace(/([a-zA-Z\)])(\d*[+-])/g, '$1$^{$2}$');

      // 3. 남은 일반 숫자 처리 (예: H2O)
      // 기호 없이 홀로 있는 숫자를 아래첨자로
      text = text.replace(/([a-zA-Z\)])(\d+)/g, '$1$_{$2}$');
      
      document.getElementById('outputText').value = text;
    }

    function copyResult() {
      const output = document.getElementById('outputText');
      output.select();
      document.execCommand('copy');
      alert("복사되었습니다!");
    }
  </script>

</body>
</html>
